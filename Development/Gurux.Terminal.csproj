<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(BuildMobile)' == 'true'">net11.0;net10.0;net11.0-android;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(BuildApple)' == 'true'">net11.0;net10.0;net11.0-android;net10.0-android;net11.0-ios;net10.0-ios</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Gurux/Gurux.Terminal</RepositoryUrl>
    <Authors>Gurux Ltd</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>GXTerminal.png</PackageIcon>
    <Copyright>Copyright (c) 1998-2026 Gurux Ltd. All rights reserved.</Copyright>
    <PackageId>Gurux.Terminal</PackageId>
    <Company>Gurux Ltd</Company>
    <Description>Modern .NET 10 and 11 Terminal media with asynchronous transport and optional Android adapters.</Description>
    <Version Condition="'$(BUILD_BUILDNUMBER)' == ''">0.0.1-local</Version>
    <Version Condition="'$(BUILD_BUILDNUMBER)' != ''">$(BUILD_BUILDNUMBER)</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GuruxSerialVersion Condition="'$(GuruxSerialVersion)' == ''">[9.0.0,9.1.0)</GuruxSerialVersion>
    <GuruxCommonVersion Condition="'$(GuruxCommonVersion)' == ''">9.0.2611.1303</GuruxCommonVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Gurux.Serial/Development/Gurux.Serial.csproj" Condition="'$(UsePublishedGuruxPackages)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="GXTerminal.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePublishedGuruxPackages)' == 'true'">
    <PackageReference Include="Gurux.Serial" Version="$(GuruxSerialVersion)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Properties/Resources.resx" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Gurux.Common" Version="9.0.2611.1601" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="GXTerminal.png" LogicalName="Gurux.Terminal.MediaIcon.png" />
  </ItemGroup>
</Project>